# Port for Express Server (Must be 3000 in this environment)
PORT=3000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET="nexus_jwt_secret_key_change_in_production_xyz123"

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexus?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/nexus_social"

# Frontend API URL (leave empty in local/preview to use same-origin proxy)
VITE_API_URL=""

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

